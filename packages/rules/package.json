{
  "name": "@maximus/rules",
  "version": "2026.8.0",
  "description": "Crowd-maintained US business compliance rule packs. Every rule cites its statute.",
  "license": "AGPL-3.0-only",
  "author": "StoneDogCode L.L.C.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesse-stonedog/maximus-compliance.git",
    "directory": "packages/rules"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/rule.v1.json": "./schema/rule.v1.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "us",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-barrel.mjs && tsc --build",
    "barrel": "node scripts/build-barrel.mjs",
    "barrel:check": "node scripts/build-barrel.mjs --check",
    "validate": "node scripts/validate.mjs",
    "staleness": "node scripts/staleness.mjs"
  },
  "//version": "Date-versioned YYYY.M.PATCH, not semver. This is data; it changes when a legislature does. A SCHEMA change is what bumps rule.v1.json to v2, and v1 rules keep working.",
  "dependencies": {
    "@maximus/engine": "0.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
